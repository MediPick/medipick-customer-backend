# ─── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://medipick:Sahasna16@localhost:5432/medipick_db

# ─── JWT ───────────────────────────────────────────────────────────────────────
# HS256 symmetric secret — change to a long random string in production
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=5
OTP_RATE_LIMIT=3
OTP_MAX_ATTEMPTS=5

# ─── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:3000,http://localhost:8000
